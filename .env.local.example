# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key for AI lesson grading (server-side only)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override Claude model used for grading (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: SimpleRisk base URL for tool_walkthrough tickets when
# initial_state.toolUrl is empty (seed default is http://localhost).
# Stand up the official self-hosted image (maps host :80 → container :80):
#   docker pull simplerisk/simplerisk
#   docker run --name simplerisk -d -p 80:80 -p 443:443 simplerisk/simplerisk
# Docs: https://www.simplerisk.com/download/docker
# Then open http://localhost (or set a cohort-specific URL below / in Admin).
NEXT_PUBLIC_SIMPLERISK_URL=http://localhost

# Stripe (server-side checkout + webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Service role key for trusted server workflows (Stripe webhooks, account deletion).
# Supabase: Settings → API → service_role — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: canonical app URL for Stripe redirect URLs in production
# NEXT_PUBLIC_APP_URL=https://cyberskill-builder.vercel.app

# Direct Postgres connection for admin scripts (e.g. npm run test:rls).
# Supabase: Settings → Database → Connection string → URI (postgres role).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or use SUPABASE_DB_URL with the same URI if you prefer a Supabase-specific name.

# Fly.io Machines sandboxes (Tier 2+ sysadmin/helpdesk tickets) — server-only
# FLY_API_TOKEN=fo1_...
# FLY_APP_NAME=your-sandbox-app
# FLY_REGION=iad
# FLY_SANDBOX_IMAGE=registry.fly.io/your-sandbox-app:latest
# Optional overrides:
# FLY_API_HOSTNAME=https://api.machines.dev
# FLY_TERMINAL_PORT=7681
# FLY_IDLE_TIMEOUT_MINUTES=20
# FLY_TERMINAL_WS_BASE=wss://your-sandbox-app.fly.dev

# Sentry error monitoring (optional — SDK is disabled when DSN is unset)
# Create a free project at https://sentry.io → Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
# SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
#
# Optional: upload source maps during `next build` (do not commit the token)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# Cost controls (POST /sandbox concurrency + GitHub Actions cron sandbox-cost-controls):
# FLY_MAX_ACTIVE_SANDBOXES_PER_TENANT=2
# FLY_SANDBOX_HOURLY_RATE_USD=0.02
# FLY_MONTHLY_SPEND_WARNING_USD=50
# Cron secrets (also needed in GitHub Actions): NEXT_PUBLIC_SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, FLY_API_TOKEN, FLY_APP_NAME, FLY_SANDBOX_IMAGE
