# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key for AI lesson grading (server-side only)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override Claude model used for grading (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Stripe (server-side checkout + webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Service role key for trusted server workflows (Stripe webhooks, account deletion).
# Supabase: Settings → API → service_role — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: canonical app URL for Stripe redirect URLs in production
# NEXT_PUBLIC_APP_URL=https://cyberskill-builder.vercel.app

# Direct Postgres connection for admin scripts (e.g. npm run test:rls).
# Supabase: Settings → Database → Connection string → URI (postgres role).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or use SUPABASE_DB_URL with the same URI if you prefer a Supabase-specific name.
